# Copy to .env for local dev or pass via --dart-define for release builds

APP_NAME=EnviVN
APP_ENV=development
APP_DEBUG=true

# OpenStreetMap tile rendering
OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_USER_AGENT=com.envivn.envivn

# Backend Service gateway (use --dart-define=BACKEND_BASE_URL=... for release)
BACKEND_BASE_URL=http://10.0.2.2:8080
CLIENT_API_KEY=
